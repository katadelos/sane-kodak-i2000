+/** Initiate a bulk transfer read from an explicit endpoint.
+ *
+ * This is intended for devices which stream independent images on multiple
+ * bulk-in endpoints at the same time.  Unlike sanei_usb_set_endpoint(), it
+ * does not mutate device-global endpoint state and is therefore safe for
+ * concurrent reads against a thread-safe USB implementation.  USB
+ * record/replay and transports without selectable endpoints are unsupported.
+ *
+ * @param dn device number
+ * @param endpoint bulk-in endpoint address, including the direction bit
+ * @param buffer buffer to store read data in
+ * @param size size of the data; replaced by the number of bytes read
+ *
+ * A libusb transfer that reports an error together with partial payload data
+ * returns that payload as a successful short read.  Callers must still
+ * validate their protocol framing before accepting the result.
+ */
+extern SANE_Status
+sanei_usb_read_bulk_endpoint (SANE_Int dn, SANE_Byte endpoint,
+                              SANE_Byte * buffer, size_t * size);
+
 /** Initiate a bulk transfer write.
  *
  * Write up to size bytes from buffer to the device. After the write size
